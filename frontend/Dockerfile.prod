# Build the static bundle, then serve it from nginx. The dev Dockerfile runs
# the Vite dev server, which must never face the internet: it is unoptimized,
# ships source maps, and has no business serving real traffic.
FROM node:22-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build


FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

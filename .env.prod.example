# Root-level env for docker-compose.prod.yml. Copy to `.env` beside the
# compose file. These are the values compose itself interpolates; the
# application's own settings live in backend/.env.
#
#   cp .env.prod.example .env

# The domain pointed at this VPS. Caddy requests a certificate for it on first
# boot, so the DNS A record must already resolve here or TLS will fail.
DOMAIN=huntops.example.com

# Let's Encrypt uses this only for expiry warnings.
TLS_EMAIL=you@example.com

# Postgres credentials. Generate the password, do not invent one by hand:
#   openssl rand -base64 32
POSTGRES_USER=huntops
POSTGRES_PASSWORD=
POSTGRES_DB=huntops

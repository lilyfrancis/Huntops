ENVIRONMENT=development

# Postgres — docker-compose provides a matching local instance
DATABASE_URL=postgresql+psycopg://huntops:huntops@localhost:5432/huntops

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173

ENABLE_SIGNUP=true
AUTO_APPROVE_EMPLOYERS=false
AUTO_APPROVE_JOBS=false

FREE_TIER_CREDITS=10
PRO_TIER_CREDITS=100
ELITE_TIER_CREDITS=500

# Paystack — https://dashboard.paystack.com/#/settings/developers
# The secret key does double duty: it authenticates API calls AND signs the
# webhooks, so there is no separate webhook secret to configure.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Plan codes from https://dashboard.paystack.com/#/plans — the price lives on
# the plan there, not here, so the two can never drift apart.
PAYSTACK_PLAN_PRO=PLN_xxx
PAYSTACK_PLAN_ELITE=PLN_xxx

FRONTEND_URL=http://localhost:5173

# Anthropic — résumé parsing and job-fit scoring (Haiku tier: cheap, fast)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_SCORING_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DRAFTING_MODEL=claude-sonnet-5

# Résumé upload
MAX_UPLOAD_SIZE_MB=5
ALLOWED_RESUME_EXTENSIONS=.pdf,.docx,.txt

# Job aggregation
AGGREGATION_DAILY_CAP=200
MAX_MATCH_CANDIDATES=40
GEO_MATCH_BOOST=15
ENABLE_SCHEDULED_AGGREGATION=true

# Adzuna — optional, gb/us only, leave blank to skip this source
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Alert mailboxes are read over IMAP and need nothing here — host, username
# and password are configured per mailbox in the admin UI.
#
# These three are ONLY for the optional "send outreach from your own Gmail"
# feature, which is off by default (ENABLE_USER_GMAIL_CONNECT). Turning it on
# needs an External OAuth client and Google verification; leaving it off costs
# nothing, because outreach falls back to the platform relay with the user's
# address as Reply-To.
ENABLE_USER_GMAIL_CONNECT=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production — encrypts IMAP mailbox passwords at rest. Left blank,
# an ephemeral key is generated per process (fine for local dev, tokens just
# won't survive a restart).
TOKEN_ENCRYPTION_KEY=

GMAIL_LABEL_NAME=HuntOps
# Mail from anything not on this list is skipped without costing an AI call,
# so an alert from a board missing here is silently ignored. Add per market.
# Subdomains match automatically (jobalerts.linkedin.com).
# Addresses on an allowed domain that are never job alerts — boards use the
# same domain to tell an employer someone applied to their posting.
EMAIL_ALERT_SENDER_EXCLUDES=employers-noreply@indeed.com,no-reply@indeed.com,employer@indeed.com,noreply-employer@glassdoor.com,invitationsr@linkedin.com,messages-noreply@linkedin.com,notifications-noreply@linkedin.com,updates-noreply@linkedin.com

EMAIL_ALERT_SENDER_DOMAINS=linkedin.com,indeed.com,glassdoor.com,ziprecruiter.com,theladders.com,reed.co.uk,totaljobs.com,cv-library.co.uk,jobsite.co.uk,adzuna.co.uk,workopolis.com,jobbank.gc.ca,eluta.ca,jobillico.com,bayt.com,gulftalent.com,naukrigulf.com,dubizzle.com,jobberman.com,myjobmag.com,hotnigerianjobs.com
ENABLE_SCHEDULED_EMAIL_SYNC=true
# How far back a mailbox reads on its first sync, or after a server
# renumbers a folder. Steady-state syncs are UID-incremental and skip this.
EMAIL_SYNC_LOOKBACK_DAYS=3

# Apollo.io — https://developer.apollo.io/ — must be a MASTER API key or
# people search returns 403. Recruiter search is free; each enrichment
# (email reveal) costs an Apollo credit.
APOLLO_API_KEY=
RECRUITER_TITLES=Recruiter,Technical Recruiter,Talent Acquisition,Talent Partner,Head of Talent,Head of People,People Operations Manager,HR Manager,Hiring Manager,Recruitment Manager
OUTREACH_CREDIT_COST=30

# Platform-sent email (digest, admin alerts) — any SMTP relay works
# (SendGrid, Postmark, SES, or a real mailbox in dev). Left blank, sends are
# skipped with a log line instead of raising.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@huntops.app
SMTP_USE_TLS=true
# Implicit TLS instead of STARTTLS. Leave unset and it follows the port —
# 465 is implicit, 587 is STARTTLS — which is right for every mainstream
# provider. Set it only for implicit TLS on a nonstandard port. Getting it
# wrong does not fail cleanly: the connection hangs until it times out.
# SMTP_USE_SSL=true

# Emailed if a scheduled job (aggregation/email-sync/digest) crashes outright.
ADMIN_ALERT_EMAIL=

# WhatsApp digest (Meta Cloud API) — optional, off unless both are set.
# https://developers.facebook.com/apps → WhatsApp → API Setup
#
# Use a permanent System User token, NOT the 24-hour temporary one the setup
# page shows first — that one expires overnight and the digest stops silently.
#
# A business-initiated message must use a template approved by Meta in advance.
# Create one with three body parameters:
#   "Hi {{1}}, you have {{2}} new job matches on HuntOps today. Top one: {{3}}"
# Leave as Meta's own host unless a provider resells the Cloud API behind
# theirs with the same request shape, in which case put their base URL here.
# Host only, no API version and no path — the version is appended by the
# code. Meta's own docs all show versioned URLs, so pasting one here is easy
# to do and produces a confusing "Unknown path components" error that names
# the phone number ID instead. Point this at whoever issued the ID: Meta
# directly, or a provider reselling the Cloud API from their own host.
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Meta calls this the "WhatsApp Business account ID" on the API Setup page,
# next to the phone number ID. Optional: it is only used to verify that the
# template below exists, is approved, and is in the language named here.
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_NAME=huntops_daily_digest
# The exact language code the template was approved in. en and en_US are
# different templates to the API, and Meta's console offers en_US far more
# prominently — a mismatch is rejected at send time, not at configure time.
WHATSAPP_TEMPLATE_LANGUAGE=en

ENABLE_SCHEDULED_DIGEST=true
DIGEST_MAX_JOBS=10

# Shown on the pricing card and in the admin revenue estimate. Keep these in
# step with the Paystack plans by hand — Paystack charges the plan's amount,
# never these, so a mismatch misprices the page without misbilling the card.
# BILLING_CURRENCY is DISPLAY ONLY — it sets what the pricing page and the
# admin dashboard show. The card is charged whatever the Paystack plan says.
# It must therefore match the currency your plans were created in, or the site
# advertises one currency and bills another. Admin -> Integrations checks this
# against your actual plans. ISO 4217: NGN, GHS, ZAR, KES, USD.
BILLING_CURRENCY=NGN
PRO_PRICE=24.0
ELITE_PRICE=89.0

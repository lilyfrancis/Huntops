ENVIRONMENT=development

# Postgres — docker-compose provides a matching local instance
DATABASE_URL=postgresql+psycopg://huntops:huntops@localhost:5432/huntops

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:3000

ENABLE_SIGNUP=true
AUTO_APPROVE_EMPLOYERS=false
AUTO_APPROVE_JOBS=false

FREE_TIER_CREDITS=10
PRO_TIER_CREDITS=100
ELITE_TIER_CREDITS=500

# Stripe — https://dashboard.stripe.com/test/apikeys and /test/webhooks
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ELITE=price_xxx

FRONTEND_URL=http://localhost:3000

# Anthropic — résumé parsing and job-fit scoring (Haiku tier: cheap, fast)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_SCORING_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DRAFTING_MODEL=claude-sonnet-5

# Résumé upload
MAX_UPLOAD_SIZE_MB=5
ALLOWED_RESUME_EXTENSIONS=.pdf,.docx,.txt

# Job aggregation
AGGREGATION_DAILY_CAP=200
MAX_MATCH_CANDIDATES=40
GEO_MATCH_BOOST=15
ENABLE_SCHEDULED_AGGREGATION=true

# Adzuna — optional, gb/us only, leave blank to skip this source
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Gmail OAuth (email-alert bridge) — https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application), add the redirect URI below
# to its authorized redirect URIs, and enable the Gmail API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production — encrypts Gmail OAuth tokens at rest. Left blank,
# an ephemeral key is generated per process (fine for local dev, tokens just
# won't survive a restart).
TOKEN_ENCRYPTION_KEY=

GMAIL_LABEL_NAME=HuntOps
EMAIL_ALERT_SENDER_DOMAINS=linkedin.com,indeed.com,glassdoor.com,jobberman.com,myjobmag.com,theladders.com
ENABLE_SCHEDULED_EMAIL_SYNC=true
EMAIL_SYNC_QUERY_WINDOW=newer_than:2d
